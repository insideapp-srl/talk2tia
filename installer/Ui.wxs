<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Talk2Tia setup UI, based on WixUI_Minimal:
     - first install: scope page (just me / all users), then the legal notice (License.rtf) that must be accepted;
     - finish page with InsideApp branding and a "Support Talk2Tia" button that opens Ko-fi;
     - maintenance (repair/remove) and patch pages from WixUI.
  -->
  <Fragment>
    <WixVariable Id="WixUILicenseRtf" Value="assets\License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="assets\Dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="assets\Banner.bmp" />

    <CustomAction Id="Talk2TiaOpenLink" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />

    <!-- Existing per-machine install found: preselect "all users" so the upgrade replaces it. -->
    <SetProperty Id="T2T_SCOPE" Value="machine" After="AppSearch" Sequence="ui" Condition="T2T_MACHINE_EXE" />

    <UI Id="Talk2TiaUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="WelcomeEulaDlg" />

      <Publish Dialog="WelcomeEulaDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_X64" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <!-- Install scope. "Just me" needs no admin rights and lets Talk2Tia update itself silently. -->
      <Property Id="T2T_SCOPE" Value="user" />
      <Dialog Id="Talk2TiaScopeDlg" Width="370" Height="270" Title="!(loc.WelcomeEulaDlg_Title)">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.WelcomeEulaDlgBitmap)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="30" Transparent="yes" NoPrefix="yes" Text="{WixUI_Font_Bigger}Welcome to Talk2Tia" />
        <Control Id="Description" Type="Text" X="135" Y="52" Width="220" Height="30" Transparent="yes" NoPrefix="yes" Text="The MCP server that lets AI assistants work with Siemens TIA Portal V21. Choose who can use it on this computer." />
        <Control Id="Scope" Type="RadioButtonGroup" X="135" Y="88" Width="220" Height="96" Property="T2T_SCOPE">
          <RadioButtonGroup Property="T2T_SCOPE">
            <RadioButton Value="user" X="0" Y="0" Width="220" Height="14" Text="&amp;Just for me (recommended)" />
            <RadioButton Value="machine" X="0" Y="50" Width="220" Height="14" Text="For &amp;all users of this computer" />
          </RadioButtonGroup>
        </Control>
        <Control Id="UserNote" Type="Text" X="148" Y="103" Width="207" Height="32" Transparent="yes" NoPrefix="yes" Text="Installs in your user profile. No administrator rights needed; updates install automatically." />
        <Control Id="MachineNote" Type="Text" X="148" Y="153" Width="207" Height="32" Transparent="yes" NoPrefix="yes" Text="Installs in Program Files. Needs administrator rights; updates ask for confirmation." />
        <Control Id="ExistingNote" Type="Text" X="135" Y="192" Width="220" Height="30" Transparent="yes" NoPrefix="yes" Hidden="yes" ShowCondition="T2T_MACHINE_EXE" Text="Talk2Tia is already installed for all users: keep that option to update it." />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Property="ALLUSERS" Value="2" Condition="T2T_SCOPE = &quot;user&quot;" Order="1" />
          <Publish Property="MSIINSTALLPERUSER" Value="1" Condition="T2T_SCOPE = &quot;user&quot;" Order="2" />
          <Publish Property="INSTALLFOLDER" Value="[LocalAppDataFolder]Programs\Talk2Tia\" Condition="T2T_SCOPE = &quot;user&quot;" Order="3" />
          <Publish Property="ALLUSERS" Value="1" Condition="T2T_SCOPE = &quot;machine&quot;" Order="4" />
          <Publish Property="MSIINSTALLPERUSER" Value="{}" Condition="T2T_SCOPE = &quot;machine&quot;" Order="5" />
          <Publish Event="EndDialog" Value="Return" Order="6" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="Talk2TiaExitDlg" Width="370" Height="270" Title="!(loc.ExitDialog_Title)">
        <Control Id="Finish" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.ExitDialogBitmap)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Talk2Tia is ready" Hidden="yes" ShowCondition="NOT Installed" />
        <Control Id="TitleMaintenance" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Talk2Tia Setup completed" Hidden="yes" ShowCondition="Installed" />
        <Control Id="Description" Type="Text" X="135" Y="60" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="Talk2Tia has been installed. Add it to your MCP client (Claude Code, Claude Desktop, VS Code...) and open TIA Portal: the guide is at talk2tia.insideapp.it/docs." Hidden="yes" ShowCondition="NOT Installed" />
        <Control Id="SupportText" Type="Text" X="135" Y="128" Width="220" Height="44" Transparent="yes" NoPrefix="yes" Text="Talk2Tia is free and open source, made by InsideApp. If it saves you time, a donation helps us test more PLCs and TIA Portal versions and keep improving it." />
        <Control Id="Donate" Type="PushButton" X="135" Y="176" Width="110" Height="17" Text="&amp;Donate on Ko-fi">
          <Publish Property="WixShellExecTarget" Value="https://ko-fi.com/insideappsrl" Order="1" />
          <Publish Event="DoAction" Value="Talk2TiaOpenLink" Order="2" />
        </Control>
        <Control Id="Website" Type="PushButton" X="251" Y="176" Width="104" Height="17" Text="&amp;Open the guide">
          <Publish Property="WixShellExecTarget" Value="https://talk2tia.insideapp.it/docs/" Order="1" />
          <Publish Event="DoAction" Value="Talk2TiaOpenLink" Order="2" />
        </Control>
        <Control Id="InsideApp" Type="PushButton" X="135" Y="198" Width="110" Height="17" Text="&amp;insideapp.it">
          <Publish Property="WixShellExecTarget" Value="https://www.insideapp.it" Order="1" />
          <Publish Event="DoAction" Value="Talk2TiaOpenLink" Order="2" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="override WelcomeDlg" Before="WelcomeEulaDlg" Condition="Installed AND PATCH" />
        <Show Dialog="Talk2TiaScopeDlg" Before="WelcomeEulaDlg" Condition="NOT Installed" />
        <Show Dialog="Talk2TiaExitDlg" OnExit="success" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="Talk2TiaExitDlg" OnExit="success" />
      </AdminUISequence>

      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
