---
import Logo from './Logo.astro';
import { links, url } from '../site';
import { localePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const home = url(localePath(lang, '/')).replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href={url(localePath(lang, '/'))}>
          <Logo />
          <span>Talk<span class="brand-two">2</span>Tia</span>
        </a>
        <p class="footer-tagline">{d.footer.tagline}</p>
      </div>
      <div>
        <h4>{d.footer.product}</h4>
        <ul>
          <li><a href={`${home}/#features`}>{d.nav.features}</a></li>
          <li><a href={url(localePath(lang, '/tools'))}>{d.footer.catalog}</a></li>
          <li><a href={links.download}>{d.nav.download}</a></li>
        </ul>
      </div>
      <div>
        <h4>{d.footer.resources}</h4>
        <ul>
          <li><a href={url(localePath(lang, '/docs'))}>{d.nav.docs}</a></li>
          <li><a href={links.repo}>GitHub</a></li>
          <li><a href={links.issues}>{d.footer.issue}</a></li>
          <li><a href={url(localePath(lang, '/legal'))}>{d.footer.legalLink}</a></li>
          <li><a href={url(localePath(lang, '/cookies'))}>{d.footer.cookieLink}</a></li>
          <li><button type="button" class="link-btn" data-cc="show-preferencesModal">{d.footer.cookiePrefs}</button></li>
        </ul>
      </div>
      <div>
        <h4>InsideApp</h4>
        <ul>
          <li><a href={links.insideapp}>insideapp.it</a></li>
          <li><a href={links.contact}>{d.footer.contact}</a></li>
          <li><a href={links.kofi} target="_blank" rel="noopener">♥ {d.support.footer}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="made-by">
        {d.footer.madeBy}
        <a href={links.insideapp}><img src={url('/insideapp-logo.svg')} alt="InsideApp" width="88" height="22" /></a>
      </span>
      <span>© {year} InsideApp S.r.l. · P.IVA 12703330014 · {d.footer.legal}</span>
    </div>
  </div>
</footer>
