---
import { links } from '../site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const d = t(Astro.props.lang).beta;
---
<div class="beta-banner" role="note">
  <div class="container beta-inner">
    <span class="beta-pill">{d.label}</span>
    <span>{d.text}</span>
    <a href={links.releases}>{d.link} →</a>
  </div>
</div>
