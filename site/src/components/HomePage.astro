---
import Base from '../layouts/Base.astro';
import { links, stats, url } from '../site';
import { localePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---
<Base lang={lang}>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-blob" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div>
        <span class="badge badge-teal">{d.hero.badge}</span> <span class="badge badge-primary">Beta · v0.9</span>
        <h1 style="margin-top:1.25rem">{d.hero.titleA} <strong>{d.hero.titleB}</strong>.<br />{d.hero.titleC}</h1>
        <p class="lead">{d.hero.lead}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={links.download}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
            {d.hero.ctaDownload}
          </a>
          <a class="btn btn-soft" href={url(localePath(lang, '/docs'))}>{d.hero.ctaDocs}</a>
        </div>
        <p class="hero-note">{d.hero.note}</p>
      </div>

      <div class="window" role="img" aria-label={d.hero.demoLabel}>
        <div class="window-bar"><i></i><i></i><i></i><span>Claude Code · talk2tia</span></div>
        <div class="chat">
          <div class="msg msg-user">{d.hero.demoUser}</div>
          <div class="tool-call"><span class="ok">✓</span> plc_read_block · FB_Conveyor · scl</div>
          <pre class="code-block"><span class="c">// added by Talk2Tia</span>
<span class="s">#JamTimer</span>(IN := <span class="s">#Sensor</span>, PT := <span class="k">T#5s</span>);
<span class="k">IF</span> <span class="s">#JamTimer</span>.Q <span class="k">THEN</span>
    <span class="s">#Motor</span> := <span class="k">FALSE</span>;
    <span class="s">#JamAlarm</span> := <span class="k">TRUE</span>;
<span class="k">END_IF</span>;</pre>
          <div class="tool-call"><span class="ok">✓</span> plc_write_scl · overwrite</div>
          <div class="tool-call"><span class="ok">✓</span> {d.hero.demoCompile}</div>
          <div class="msg msg-bot" set:html={d.hero.demoBot} />
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section border-bottom" id="features">
    <div class="container">
      <div class="section-head">
        <span class="badge badge-primary">{d.features.badge}</span>
        <h2>{d.features.title}</h2>
        <p class="lead">{d.features.lead}</p>
      </div>
      <div class="grid grid-3">
        {d.features.items.map((f) => (
          <div class="feature">
            <div class={`feature-icon ${f.tone}`}>
              {f.icon === 'code' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg>}
              {f.icon === 'layers' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2" /><polyline points="2 17 12 22 22 17" /><polyline points="2 12 12 17 22 12" /></svg>}
              {f.icon === 'check' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>}
              {f.icon === 'cpu' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" /><rect x="9" y="9" width="6" height="6" /><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" /></svg>}
              {f.icon === 'tag' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" /><line x1="7" y1="7" x2="7.01" y2="7" /></svg>}
              {f.icon === 'shield' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>}
            </div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section-gray" id="how-it-works">
    <div class="container">
      <div class="grid grid-2" style="align-items:center;gap:4rem">
        <div>
          <span class="badge badge-teal">{d.how.badge}</span>
          <h2 style="margin-top:1rem">{d.how.title}</h2>
          <div class="steps grid" style="margin-top:2rem;gap:1.75rem">
            {d.how.steps.map((s) => (
              <div class="step">
                <h4>{s.title}</h4>
                <p>{s.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="window">
          <div class="window-bar"><i></i><i></i><i></i><span>PowerShell</span></div>
          <pre class="code-block" style="border-radius:0"><span class="c">{d.how.c1}</span>
talk2tia --doctor
[ OK ] TIA Portal V21 Openness API
[ OK ] User in 'Siemens TIA Openness' group

<span class="c">{d.how.c2}</span>
claude mcp add talk2tia -- <span class="s">"C:\Program Files\Talk2Tia\talk2tia.exe"</span>

<span class="c">{d.how.c3}</span>
$env:TALK2TIA_TOOLSETS = <span class="s">"plc,library"</span></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <svg class="curve" viewBox="0 0 2880 48" preserveAspectRatio="none" aria-hidden="true"><path d="M0 48h2880V0h-720C1442.5 52 720 0 720 0H0v48z" fill="currentColor" /></svg>
  <section class="section section-dark">
    <div class="container">
      <div class="stats">
        <div><div class="stat-value">{stats.tools}</div><div class="stat-label">{d.stats.tools}</div></div>
        <div><div class="stat-value">{stats.toolsets}</div><div class="stat-label">{d.stats.toolsets}</div></div>
        <div><div class="stat-value">3</div><div class="stat-label">{d.stats.formats}</div></div>
        <div><div class="stat-value">100<span>%</span></div><div class="stat-label">{d.stats.api}</div></div>
      </div>
    </div>
  </section>

  <!-- TOOLSETS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="badge badge-primary">{d.toolsets.badge}</span>
        <h2>{d.toolsets.title}</h2>
        <p class="lead">{d.toolsets.lead}</p>
      </div>
      <div class="grid grid-3">
        {d.toolsets.items.map((ts) => (
          <a class="card" href={url(localePath(lang, '/tools'))}>
            <span class="toolset-count">{ts.count}</span>
            <h3>{ts.name}</h3>
            <p class="toolset-id"><code>{ts.id}</code></p>
            <p class="toolset-text">{ts.text}</p>
          </a>
        ))}
        <a class="card card-muted" href={url(localePath(lang, '/tools'))}>
          <h3 class="text-primary">{d.toolsets.all}</h3>
          <p class="text-muted">{d.toolsets.allText}</p>
        </a>
      </div>
    </div>
  </section>

  <!-- SAFETY + REQUIREMENTS -->
  <section class="section section-gray" id="download">
    <div class="container grid grid-2" style="gap:3rem">
      <div class="card">
        <span class="badge badge-success">{d.safety.badge}</span>
        <h3 style="margin-top:1rem">{d.safety.title}</h3>
        <ul class="check-list">{d.safety.items.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div class="card">
        <span class="badge badge-primary">{d.req.badge}</span>
        <h3 style="margin-top:1rem">{d.req.title}</h3>
        <ul class="check-list">{d.req.items.map((i) => <li>{i}</li>)}</ul>
        <div class="btn-row" style="margin-top:1.75rem">
          <a class="btn btn-primary" href={links.download}>{d.req.latest}</a>
          <a class="btn btn-soft" href={links.releases}>{d.req.all}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container narrow">
      <div class="section-head" style="margin-bottom:2rem">
        <span class="badge badge-teal">{d.faq.badge}</span>
        <h2>{d.faq.title}</h2>
      </div>
      <div class="faq">
        {d.faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a} </p>
          </details>
        ))}
      </div>
      <p class="text-muted" style="margin-top:1.5rem;font-size:.9375rem">
        <a href={url(localePath(lang, '/legal'))}>{d.footer.legalLink} →</a>
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="cta">
        <h2>{d.cta.title}</h2>
        <p class="lead">{d.cta.lead}</p>
        <div class="btn-row center" style="margin-top:1.5rem">
          <a class="btn btn-white" href={links.contact}>{d.cta.contact}</a>
          <a class="btn btn-outline-light" href={links.repo}>{d.cta.github}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
