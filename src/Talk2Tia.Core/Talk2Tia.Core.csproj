<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- TIA Portal Openness V21 ships its public API for .NET Framework 4.8 only. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- TIA Portal is a 64-bit process; Openness clients must run as x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Talk2Tia.Core</RootNamespace>
    <AssemblyName>Talk2Tia.Core</AssemblyName>
    <Product>Talk2Tia</Product>
    <Company>InsideApp</Company>
    <Copyright>Copyright (c) 2026 InsideApp S.r.l. MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.0</Version>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Default install location; override with /p:TiaPublicApiDir=... -->
    <TiaPublicApiDir Condition="'$(TiaPublicApiDir)' == ''">C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21\net48</TiaPublicApiDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Siemens assemblies are referenced for compilation only (Private=false).
    They must NOT be copied next to the executable: at runtime they are resolved
    from the TIA Portal installation (see Openness/OpennessResolver.cs).
  -->
  <ItemGroup>
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(TiaPublicApiDir)\Siemens.Engineering.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>$(TiaPublicApiDir)\Siemens.Engineering.Step7.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.WinCC">
      <HintPath>$(TiaPublicApiDir)\Siemens.Engineering.WinCC.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.WinCC.Extension">
      <HintPath>$(TiaPublicApiDir)\Siemens.Engineering.WinCC.Extension.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.WinCCUnified">
      <HintPath>$(TiaPublicApiDir)\Siemens.Engineering.WinCCUnified.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Notification-area icon (Tray/TrayIcon.cs). -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <EmbeddedResource Include="..\..\installer\assets\talk2tia.ico" LogicalName="Talk2Tia.Core.talk2tia.ico" />
    <EmbeddedResource Include="..\..\installer\assets\insideapp.png" LogicalName="Talk2Tia.Core.insideapp.png" />
    <EmbeddedResource Include="..\..\installer\assets\talk2tia-128.png" LogicalName="Talk2Tia.Core.talk2tia-128.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Talk2Tia.Tests" />
  </ItemGroup>

</Project>
